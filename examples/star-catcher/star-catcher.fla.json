  "timelines": [
    {
      "name": "Scene 1",
      "layers": [
        {
          "name": "actions",
          "frames": [
            {
              "index": 0,
              "duration": 1,
              "actionScript": ["stop();", "", "play_btn.onRelease = function () {", "  gotoAndStop(\"game\");", "};"]
            },
            {
              "index": 1,
              "duration": 1,
              "actionScript": [
                "score = 0;",
                "starCount = 0;",
                "lastX = -1000;",
                "lastY = -1000;",
                "",
                "function spawnStar() {",
                "  starCount++;",
                "  var star = attachMovie(\"Star\", \"star\" + starCount, starCount);",
                "",
                "  // somewhere new, fully on stage and below the score",
                "  do {",
                "    star._x = 90 + Math.random() * (Stage.width - 180);",
                "    star._y = 150 + Math.random() * (Stage.height - 230);",
                "  } while (Math.abs(star._x - lastX) + Math.abs(star._y - lastY) < 220);",
                "  lastX = star._x;",
                "  lastY = star._y;",
                "",
                "  star.onRelease = function () {",
                "    this.enabled = false;        // no double taps while it shrinks",
                "    this.gotoAndPlay(\"shrink\");  // shrinks, then removes itself",
                "    score++;",
                "    if (score >= 10) {",
                "      gotoAndStop(\"gameover\");",
                "    } else {",
                "      spawnStar();",
                "    }",
                "  };",
                "}",
                "",
                "spawnStar();"
              ]
            },
            {
              "index": 2,
              "duration": 1,
              "actionScript": ["retry_btn.onRelease = function () {", "  gotoAndStop(\"game\");", "};"]
            }
